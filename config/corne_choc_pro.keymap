#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <locale/keys_se.h>
#define SE_A_UMLAUT_B ZMK_HID_USAGE(HID_USAGE_KEY, HID_USAGE_KEY_KEYBOARD_LEFT_BRACKET_AND_BRACE)

/ {
  chosen { zmk,physical-layout = &default_layout; };
};

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "QWERTY";

      bindings = <
        &kp TAB    &kp Q  &kp W  &kp E      &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O      &kp P           &kp SE_A_RING
        &kp LSHFT  &kp A  &kp S  &kp D      &kp F  &kp G        &kp H    &kp J  &kp K      &kp L      &kp SE_O_UMLAUT &kp SE_A_UMLAUT
        &kp LCTRL  &kp Z  &kp X  &kp C      &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT    &kp SE_MINUS    &kp ESC
                                 &kp LGUI   &mo 1  &kp SPACE    &kp RET  &mo 2  &kp LALT
      >;
    };

    lower_layer {
      display-name = "NUMBER";

      bindings = <
        &trans  &trans  &kp N1  &kp N2  &kp N3  &kp SE_PLUS     &kp PSCRN    &kp C_VOL_DN      &kp C_VOL_UP  &trans     &trans  &kp SE_QUESTION
        &trans  &trans  &kp N4  &kp N5  &kp N6  &kp N0          &kp LEFT     &kp DOWN          &kp UP        &kp RIGHT  &trans  &kp SE_APOS
        &trans  &trans  &kp N7  &kp N8  &kp N9  &kp SE_MINUS    &none        &none             &kp COMMA     &kp DOT    &trans  &trans
                                &trans  &trans  &trans          &kp BSPC     &mo 4             &trans
      >;
    };


    raise_layer {
      display-name = "SYMBOL";

      bindings = <
        &kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS     &kp SE_LBRC   &kp SE_RBRC  &kp RPAR      &kp SE_QUESTION
        &kp LCTRL  &trans    &trans  &trans    &trans    &trans     &kp MINUS  &kp SE_FSLH  &kp SE_LPAR   &kp SE_RPAR  &kp BSLH      &kp SE_APOS
        &kp LSHFT  &trans    &trans  &trans    &trans    &trans     &kp UNDER  &kp PLUS     &kp COMMA     &kp DOT      &kp SE_MINUS  &trans
                                     &trans    &trans    &trans     &trans     &trans       &trans
      >;
    };

    Control {
      display-name = "SYSTEM";
      bindings = <
        &none  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none      &none    &none      &none    &trans  &kp F24
        &none  &none         &none            &none         &none         &none           &none      &none    &none      &none    &none   &kp F23
        &none  &bt BT_CLR    &rgb_ug RGB_TOG  &sys_reset    &bootloader   &studio_unlock  &trans     &trans   &trans     &trans   &trans  &trans
                                              &trans        &trans        &trans          &trans     &trans   &trans
      >;
    };

    extra_layer_1 {
      display-name = "EXTRA";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp END    &kp HOME   &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PG_DN  &kp PG_UP  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
        &trans  &trans  &trans                                                        &trans  &trans  &trans
      >;
    };

    extra_layer_2 {
      display-name = "EXTRA 2";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans                                                  &trans  &trans  &trans
      >;
    };

    extra_layer_3 {
      display-name = "EXTRA 3";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans                                                  &trans  &trans  &trans
      >;
    };

    extra_layer_4 {
      display-name = "EXTRA 4";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans                                                  &trans  &trans  &trans
      >;
    };

    extra_layer_5 {
      display-name = "EXTRA 5";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans                                                  &trans  &trans  &trans
      >;
    };

    extra_layer_6 {
      display-name = "EXTRA 6";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans                                                  &trans  &trans  &trans
      >;
    };
  };
};
